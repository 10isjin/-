rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "yelloboll@goedu.kr";
    }

    // --- Rules ---

    // Anyone can read profiles, classes, stats, and runs
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /runs/{runId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /globalStats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/visitors {
      allow read: if isAdmin();
      // Allow public creation and updates for tracking (increments)
      allow create, update: if true;
    }
  }
}
